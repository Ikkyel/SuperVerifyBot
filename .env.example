# Token bot dari @BotFather (JANGAN dibagikan ke siapa pun; di Heroku taruh di Config Vars)
BOT_TOKEN=

# ID Telegram owner/admin utama bot (contoh di bawah ini ID owner project ini)
OWNER_ID=9270334972

# URI MongoDB Atlas, contoh: mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Nama database di MongoDB (opsional)
MONGODB_DB=verifybot

# ID grup forum (supergroup bertopik) untuk log verifikasi, contoh: -1001234567890
# Opsional: kalau kosong, tetapkan lewat perintah /setlog di dalam grup log.
LOG_GROUP_ID=
